# Copy this file to .env and fill in the keys you need.
# .env is gitignored; .env.example is the template that lives in git.

# ─── LLM provider API keys (only the ones you use need to be set) ───────
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ─── Chatbot config ─────────────────────────────────────────────────────
# LiteLLM model string. Examples:
#   groq/llama-3.3-70b-versatile
#   groq/llama-3.1-8b-instant
#   anthropic/claude-sonnet-4-5
#   openai/gpt-5
#   gemini/gemini-2.5-pro
CHATBOT_LLM_MODEL=groq/llama-3.3-70b-versatile

# ─── Telegram bot (optional — only needed if running the Telegram frontend) ─
# Get a token from @BotFather, then paste it here.
TELEGRAM_BOT_TOKEN=

# ─── Telegram sync (optional — pulls new messages directly from MTProto) ───
# Credentials from https://my.telegram.org/apps (tied to a user account, NOT
# the bot). Used only by scripts/00_telegram_sync.py.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone number for that account in international format, e.g. +213XXXXXXXXX.
# Used once to log in; afterwards Telethon caches data/.telethon.session.
TELEGRAM_PHONE=
# Group to sync. Either an @username or the numeric chat id (positive form;
# the script converts to MTProto's -100<id> automatically). Leave blank to
# use the first chat already present in data/result.json.
TELEGRAM_GROUP=

# ─── Database ───────────────────────────────────────────────────────────
# Postgres for conversation memory + user registry. Default points at the
# docker-compose service published on localhost:5433 (not 5432 — avoids
# clashing with any host-installed Postgres).
DATABASE_URL=postgresql://ensia:ensia@localhost:5433/ensia_bot
