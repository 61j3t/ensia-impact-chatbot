# Python
__pycache__/
*.py[cod]
.venv/
.Python

# ChromaDB persistent store (regenerable from scripts/ + data/)
chatbot/chroma_db/

# Secrets — API keys, etc.
.env
.env.*
!.env.example

# Telethon session file — auth credential, do NOT commit.
data/.telethon.session
data/.telethon.session-journal

# Dashboard corpus-status snapshot (regenerated by scripts/07_status_snapshot.py)
data/_status.json

# Old SQLite memory (replaced by Postgres in docker-compose.yml).
# Kept here so any leftover files don't accidentally get committed.
data/conversations.db
data/conversations.db-journal
data/conversations.db-wal
data/conversations.db-shm

# Eval outputs (keep them by default — useful history — but uncomment if needed)
# eval/reports/

# Dashboard (Next.js) build output + node deps
dashboard/node_modules/
dashboard/.next/
dashboard/next-env.d.ts
dashboard/*.tsbuildinfo

# OS
.DS_Store

# Editor
.idea/
.vscode/
