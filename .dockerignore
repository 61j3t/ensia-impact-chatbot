# What Docker should NOT ship into the build context. Mirrors .gitignore
# in spirit, but Docker reads this independently. Keeping it tight makes
# the HF Space build faster and shrinks the image.

.git/
.venv/
.idea/
.vscode/
.DS_Store
__pycache__/
*.py[cod]
*.tsbuildinfo

# Don't ship the Next.js dashboard inside the bot image — it lives on
# Vercel as its own deployment.
dashboard/

# Local-only secrets / artifacts.
.env
.env.*
!.env.example

# OCR / scrape intermediates we don't need in the deployed image
# (they're regenerated by the pipeline anyway and just slow the cold
# start). Keep result.json + messages_enriched.json + chroma_db so the
# bot starts answering immediately.
data/chats/

# Notebook + eval artefacts not needed at runtime.
eda.ipynb
eval/reports/
